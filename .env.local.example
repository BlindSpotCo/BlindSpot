# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local itself.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google AI Studio (aistudio.google.com/apikey) — powers the SunScout
# "AI Report" button (Gemini Vision shadow analysis) AND the floor-plan
# furnishing advisor (/floor-plan-analysis, Gemini Vision floor-plan
# reading). Without this, the rest of the site works fine but both of
# those features return a 500.
GEMINI_API_KEY=your-gemini-api-key
